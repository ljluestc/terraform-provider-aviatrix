package aviatrix

import (
	"fmt"
	"testing"

	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/resource"
	"github.com/hashicorp/terraform-plugin-sdk/v2/terraform"
)

// Example integration test demonstrating the framework usage
// This file serves as a template for creating integration tests for all 282 resources

// TestIntegrationFramework_AccountExample demonstrates complete CRUD testing
func TestIntegrationFramework_AccountExample(t *testing.T) {
	if !IsAcceptanceTest() {
		t.Skip("Skipping acceptance test (TF_ACC not set)")
	}

	// Initialize the framework
	framework := NewIntegrationTestFramework(t, "aviatrix_account", nil)
	dataProvider := framework.testDataProvider

	// Generate test data
	accountName := dataProvider.GenerateAccountName("aws")
	accountNumber := "123456789012" // Example AWS account
	roleARN := fmt.Sprintf("arn:aws:iam::%s:role/aviatrix-role-app", accountNumber)

	// Run CRUD test
	framework.GenerateCRUDTest(CRUDTestConfig{
		ResourceName:            "aviatrix_account.test",
		PreCheck:                func() { PreCheckController(t) },
		CreateConfig:            testAccAccountConfigAWSExample(accountName, accountNumber, roleARN),
		UpdateConfig:            testAccAccountConfigAWSUpdateExample(accountName, accountNumber, roleARN),
		ImportStateVerifyIgnore: []string{"aws_role_arn"},
		CreateChecks: []resource.TestCheckFunc{
			resource.TestCheckResourceAttr("aviatrix_account.test", "account_name", accountName),
			resource.TestCheckResourceAttr("aviatrix_account.test", "cloud_type", "1"),
			resource.TestCheckResourceAttrSet("aviatrix_account.test", "aws_account_number"),
		},
		UpdateChecks: []resource.TestCheckFunc{
			resource.TestCheckResourceAttr("aviatrix_account.test", "account_name", accountName),
			resource.TestCheckResourceAttr("aviatrix_account.test", "cloud_type", "1"),
		},
	})(t)
}

// TestIntegrationFramework_ErrorHandlingExample demonstrates error handling tests
func TestIntegrationFramework_ErrorHandlingExample(t *testing.T) {
	if !IsAcceptanceTest() {
		t.Skip("Skipping acceptance test (TF_ACC not set)")
	}

	framework := NewIntegrationTestFramework(t, "aviatrix_account", nil)

	framework.GenerateErrorHandlingTests([]ErrorHandlingTestConfig{
		{
			Name:              "invalid_cloud_type",
			Config:            testAccAccountConfigInvalidCloudType(),
			ExpectError:       true,
			ErrorMessageMatch: "invalid cloud type",
			PreCheck:          func() { PreCheckController(t) },
		},
		{
			Name:              "missing_required_field",
			Config:            testAccAccountConfigMissingField(),
			ExpectError:       true,
			ErrorMessageMatch: "required",
			PreCheck:          func() { PreCheckController(t) },
		},
	})(t)
}

// TestIntegrationFramework_DependencyExample demonstrates dependency testing
func TestIntegrationFramework_DependencyExample(t *testing.T) {
	if !IsAcceptanceTest() {
		t.Skip("Skipping acceptance test (TF_ACC not set)")
	}

	framework := NewIntegrationTestFramework(t, "aviatrix_spoke_gateway", nil)
	dataProvider := framework.testDataProvider

	accountName := dataProvider.GenerateAccountName("aws")
	gatewayName := dataProvider.GenerateGatewayName()
	vpcName := dataProvider.GenerateVPCName()

	framework.GenerateDependencyTest(DependencyTestConfig{
		ResourceName:     "aviatrix_spoke_gateway.test",
		DependencyConfig: testAccAccountConfigAWSExample(accountName, "123456789012", "arn:aws:iam::123456789012:role/aviatrix-role-app"),
		DependentConfig:  testAccSpokeGatewayConfig(gatewayName, vpcName, accountName),
		Checks: []resource.TestCheckFunc{
			resource.TestCheckResourceAttr("aviatrix_spoke_gateway.test", "gw_name", gatewayName),
			resource.TestCheckResourceAttrSet("aviatrix_spoke_gateway.test", "vpc_id"),
		},
		PreCheck: func() { PreCheckController(t) },
	})(t)
}

